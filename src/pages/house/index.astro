---
import Layout from '@/layout/Layout.astro';
import PageHeader from '@/components/pages/PageHeader.astro';
import HouseStorySection from '@/components/pages/house/HouseStorySection.astro';
import HouseTimelineSection from '@/components/pages/house/HouseTimelineSection.astro';
import HeaderBackgroundImage from '@/assets/images/sleep/header.jpg';
import HostSection from '@/components/HostSection.astro';
---

<Layout
    headerVariant="transparent"
    title="La maison"
    description="Une longère flamande de 1834 restaurée pierre par pierre — l’histoire du Clos des 3 Monts et de ses hôtes, Camille & Étienne."
>
    <div class="clos-fade">
        <PageHeader
            backgroundImage={HeaderBackgroundImage}
            eyebrow="La maison"
            title="Restaurée pierre par pierre"
        />
        <HouseStorySection />
        <HouseTimelineSection />
        <HostSection />
    </div>
</Layout>
