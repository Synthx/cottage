---
import Layout from '@/layout/Layout.astro';
import {
    ADDRESS,
    APP_NAME,
    CONTACT_EMAIL,
    CONTACT_PHONE,
} from '@/config/contact.ts';
import BackgroundSection from '@/components/pages/BackgroundSection.astro';

const phoneHref = `tel:${CONTACT_PHONE.replace(/[^+\d]/g, '')}`;
const mailHref = `mailto:${CONTACT_EMAIL}`;
---

<Layout
    title="Mentions légales"
    description="Mentions légales du Clos des 3 Monts — éditeur, hébergement et propriété intellectuelle."
>
    <BackgroundSection
        backgroundColor="base"
        eyebrow="Informations légales"
        title="Mentions légales"
    >
        <div class="legal-inner">
            <div class="prose">
                <h2>Législation</h2>
                <p>
                    Droit d’auteur et propriété intellectuelle. Selon la loi du
                    11 mars 1957 (art. 41) et du code de la propriété
                    intellectuelle du 1er juillet 1992, le site internet {
                        Astro.site
                    } (textes, éléments graphiques, photographies, etc.) constitue
                    une œuvre protégée en France par le Code de la Propriété intellectuelle,
                    et à l’étranger par les conventions internationales en vigueur
                    sur le droit d’auteur.
                </p>

                <h2>Données à caractère personnel</h2>
                <p>
                    En application de la loi n°78-17 du 6 janvier 1978 relative
                    à l’informatique, aux fichiers et aux libertés, l’internaute
                    dispose du droit d’opposition (art. 26 de la loi), d’accès
                    (art. 34 à 38 de la loi) et de rectification. Pour exercer
                    ce droit vous pouvez vous adresser à :
                </p>
                <p>
                    <strong>{APP_NAME}</strong>
                    {
                        ADDRESS.map((line) => (
                            <>
                                {line}
                                <br />
                            </>
                        ))
                    }
                    <a href={phoneHref}>{CONTACT_PHONE}</a><br />
                    Ou par email :
                    <a href={mailHref}>{CONTACT_EMAIL}</a>
                </p>

                <h2>Informations</h2>
                <p>
                    La présence des liens hypertextes vers d’autres sites
                    internet n’engage pas la responsabilité du site {
                        Astro.site
                    }. Ces liens ne sont là qu’à titre indicatif.
                </p>
            </div>

            <aside class="aside">
                <div class="card">
                    <h3>Développement et intégration</h3>
                    <p>Remi Taniel</p>
                </div>
                <div class="card">
                    <h3>Hébergement</h3>
                    <address>
                        <span>OVH SAS</span>
                        <span>2 rue Kellermann</span>
                        <span>59100 Roubaix</span>
                        <a href="tel:+33444446040">+33 (0)4 44 44 60 40</a>
                        <a href="https://www.ovhcloud.com/fr/" target="_blank"
                            >www.ovhcloud.com</a
                        >
                    </address>
                </div>
            </aside>
        </div>
    </BackgroundSection>
</Layout>
