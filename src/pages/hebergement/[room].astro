---
import type { GetStaticPaths } from 'astro';
import { getCollection, render } from 'astro:content';
import Picture from 'astro/components/Picture.astro';

import Layout from '@/layout/Layout.astro';
import Breadcrumb from '@/components/pages/Breadcrumb.astro';
import SectionTitle from '@/components/pages/SectionTitle.astro';
import { CONTACT_EMAIL, CONTACT_PHONE } from '@/config/contact.ts';
import type { Link } from '@/content/schemas/shared.ts';

export const getStaticPaths = (async () => {
    const slugFromHref = (href: string) =>
        href.replace('/hebergement/', '').replace(/\/$/, '');

    const bedrooms = await getCollection('bedrooms');
    return bedrooms.map((entry) => ({
        params: { room: slugFromHref(entry.data.href) },
        props: { entry },
    }));
}) satisfies GetStaticPaths;

const DEFAULT_AMENITIES = [
    'Salle de douche et toilettes privatives',
    'Serviettes de toilette et linge de lit',
    'Gel douche et shampoing',
    'Sèche-cheveux',
    'Télévision',
    'WiFi haut débit',
    'Coffre-fort',
    'Machine à café Nespresso',
    'Bouilloire électrique',
    'Thé et tisanes Palais des Thés',
    'Parapluie',
    'Draps de plage',
];

const { entry } = Astro.props;
const { name, image, capacity, surface, bed, price, amenities } = entry.data;
const { Content } = await render(entry);

const equipments = amenities ?? DEFAULT_AMENITIES;
const phoneHref = `tel:${CONTACT_PHONE.replace(/[^+\d]/g, '')}`;
const mailHref = `mailto:${CONTACT_EMAIL}?subject=${encodeURIComponent(
    `Réservation — Chambre ${name}`,
)}`;

const BREADCRUMBS: Link[] = [
    {
        href: '/bedrooms',
        label: 'Les chambres',
    },
];
---

<Layout
    headerVariant="transparent"
    title={`Chambre ${name}`}
    description={`Chambre d’hôtes ${name} — ${capacity} personnes, ${surface} m², ${bed}. À partir de ${price} € la nuit, petit-déjeuner inclus.`}
>
    <section class="room-hero">
        <Picture
            src={image}
            formats={['avif', 'webp']}
            layout="full-width"
            loading="eager"
            fetchpriority="high"
            class="room-hero-image"
            alt={`Chambre ${name}`}
        />
        <div class="room-hero-content">
            <Breadcrumb links={BREADCRUMBS} />
            <h1>Chambre {name}</h1>
            <ul class="room-hero-specs">
                <li>
                    <svg
                        class="spec-icon"
                        viewBox="0 0 24 24"
                        fill="none"
                        stroke="currentColor"
                        stroke-width="1.5"
                        stroke-linecap="round"
                        stroke-linejoin="round"
                        aria-hidden="true"
                    >
                        <path d="M12 12a4 4 0 1 0 0-8 4 4 0 0 0 0 8Z"></path>
                        <path d="M4 20a8 8 0 0 1 16 0"></path>
                    </svg>
                    <span>{capacity} personnes</span>
                </li>
                <li>
                    <svg
                        class="spec-icon"
                        viewBox="0 0 24 24"
                        fill="none"
                        stroke="currentColor"
                        stroke-width="1.5"
                        stroke-linecap="round"
                        stroke-linejoin="round"
                        aria-hidden="true"
                    >
                        <path
                            d="M3 18v-5h18v5M3 13V8h5v5M21 13v-2a3 3 0 0 0-3-3h-6v5"
                        ></path>
                        <path d="M3 18v2M21 18v2"></path>
                    </svg>
                    <span>{bed}</span>
                </li>
                <li>
                    <svg
                        class="spec-icon"
                        viewBox="0 0 24 24"
                        fill="none"
                        stroke="currentColor"
                        stroke-width="1.5"
                        stroke-linecap="round"
                        stroke-linejoin="round"
                        aria-hidden="true"
                    >
                        <path d="M4 4h16v16H4z"></path>
                        <path d="M4 9h4M4 9V5M20 15h-4M20 15v4"></path>
                    </svg>
                    <span>{surface} m²</span>
                </li>
            </ul>
        </div>
    </section>

    <section class="room-main">
        <div class="room-content">
            <div class="room-description">
                <Content />
            </div>
            <div class="room-equipments">
                <h2>Équipements</h2>
                <ul>
                    {equipments.map((item) => <li>{item}</li>)}
                </ul>
            </div>
        </div>

        <aside class="room-booking">
            <p class="room-booking-price">
                À partir de <strong>{price} €</strong><span>/ nuit</span>
            </p>
            <p class="room-booking-note">Petit-déjeuner inclus.</p>
            <a class="room-booking-cta" href={mailHref}>Réserver en ligne</a>
            <a class="room-booking-phone" href={phoneHref}>{CONTACT_PHONE}</a>
        </aside>
    </section>

    <section class="room-others">
        <SectionTitle level="h2" subtitle="Se reposer">
            Découvrez nos autres chambres
        </SectionTitle>
    </section>
</Layout>

<style>
    .room-hero {
        position: relative;
        display: flex;
        align-items: flex-end;
        min-height: 60vh;
        overflow: hidden;

        &:after {
            content: '';
            position: absolute;
            inset: 0;
            background: linear-gradient(
                to top,
                rgba(0, 0, 0, 0.65),
                rgba(0, 0, 0, 0.15) 45%,
                rgba(0, 0, 0, 0.35)
            );
        }
    }

    .room-hero-image {
        position: absolute;
        inset: 0;
        z-index: -1;
        height: 100%;
        width: 100%;
        object-fit: cover;
        object-position: center;
    }

    .room-hero-content {
        position: relative;
        z-index: 1;
        display: flex;
        flex-direction: column;
        gap: var(--spacing-100);
        width: 100%;
        max-width: 1280px;
        margin: 0 auto;
        padding: var(--spacing-250) var(--spacing-125) var(--spacing-300);
        color: var(--color-fg-brand);

        @media (min-width: 1024px) {
            padding-inline: var(--spacing-500);
        }

        h1 {
            color: var(--color-fg-brand);
        }

        :global(.breadcrumb a) {
            color: var(--color-fg-brand);
            text-decoration: none;
            opacity: 0.85;
        }
    }

    .room-hero-specs {
        display: flex;
        flex-wrap: wrap;
        gap: var(--spacing-100) var(--spacing-250);

        li {
            display: flex;
            align-items: center;
            gap: var(--spacing-50);
            font-size: var(--font-body-m);
        }

        .spec-icon {
            height: 22px;
            width: 22px;
            flex-shrink: 0;
        }
    }

    .room-main {
        display: grid;
        grid-template-columns: 1fr;
        gap: var(--spacing-400);
        width: 100%;
        max-width: 1280px;
        margin: 0 auto;
        padding: var(--spacing-500) var(--spacing-125);

        @media (min-width: 1024px) {
            grid-template-columns: 2fr 1fr;
            padding-inline: var(--spacing-500);
        }
    }

    .room-content {
        display: flex;
        flex-direction: column;
        gap: var(--spacing-400);
    }

    .room-description {
        display: flex;
        flex-direction: column;
        gap: var(--spacing-100);

        :global(p) {
            font-size: var(--font-body-l);
            line-height: var(--font-line-height-body-l);
        }
    }

    .room-equipments {
        display: flex;
        flex-direction: column;
        gap: var(--spacing-150);

        h2 {
            font-size: var(--font-title-m);
            line-height: var(--font-line-height-title-m);
        }

        ul {
            display: grid;
            grid-template-columns: 1fr;
            gap: var(--spacing-75);

            @media (min-width: 640px) {
                grid-template-columns: repeat(2, 1fr);
            }
        }

        li {
            position: relative;
            padding-left: var(--spacing-150);

            &:before {
                content: '';
                position: absolute;
                top: 0.55em;
                left: 0;
                height: 6px;
                width: 6px;
                border-radius: var(--radius-full);
                background: var(--color-bg-dark);
            }
        }
    }

    .room-booking {
        display: flex;
        flex-direction: column;
        gap: var(--spacing-75);
        align-self: start;
        padding: var(--spacing-200);
        background: var(--color-bg-alternate);
        border-radius: var(--radius-xs);
        box-shadow:
            rgba(0, 0, 0, 0.2) 0 2px 3px,
            rgba(0, 0, 0, 0.1) 0 5px 32px;

        @media (min-width: 1024px) {
            position: sticky;
            top: var(--spacing-500);
        }
    }

    .room-booking-price {
        color: var(--color-fg);
        font-size: var(--font-body-l);

        strong {
            color: var(--color-fg-brand);
            font-family: var(--font-family-title), system-ui;
            font-size: var(--font-title-m);
            font-weight: var(--font-bold);
        }

        span {
            margin-left: var(--spacing-25);
            color: var(--secondary);
            font-size: var(--font-body-s);
        }
    }

    .room-booking-note {
        color: var(--secondary);
        font-size: var(--font-body-s);
    }

    .room-booking-cta {
        margin-top: var(--spacing-75);
        padding: 12px 20px;
        background: var(--color-bg-brand);
        color: var(--color-fg-inverse);
        text-align: center;
        text-transform: uppercase;
        text-decoration: none;
        border-radius: var(--radius-xxxs);
        font-size: var(--font-body-m);
        transition: opacity 0.2s ease;

        &:hover {
            opacity: 0.9;
        }
    }

    .room-booking-phone {
        color: var(--color-fg-brand);
        text-align: center;
        text-decoration: none;
        font-size: var(--font-body-m);
    }

    .room-others {
        display: flex;
        flex-direction: column;
        gap: var(--spacing-300);
        width: 100%;
        max-width: 1280px;
        margin: 0 auto;
        padding: var(--spacing-250) var(--spacing-125) var(--spacing-500);

        @media (min-width: 1024px) {
            padding-inline: var(--spacing-500);
        }
    }

    .room-others-grid {
        display: grid;
        grid-template-columns: 1fr;
        gap: var(--spacing-250);

        @media (min-width: 768px) {
            grid-template-columns: repeat(2, 1fr);
        }
    }
</style>
