---
import { APP_NAME } from '@/config/contact.ts';
import { NAVIGATION } from '@/config/navigation.ts';
---

<div class="header-desktop">
    <a class="brand" href="/">
        {APP_NAME}
    </a>
    <nav class="header-desktop-nav" aria-label="Navigation principale">
        {NAVIGATION.map((item) => <a href={item.href}>{item.label}</a>)}
        <a class="cta" href="/contact"> Réserver </a>
    </nav>
</div>

<style>
    .header-desktop {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: var(--spacing-150);
        width: 100%;
        max-width: 1280px;
        margin: 0 auto;
        padding-block: var(--spacing-100);
        padding-inline: var(--spacing-450);

        .header-desktop-nav {
            display: flex;
            align-items: center;
            gap: var(--spacing-100);

            a {
                text-decoration: none;
                font-size: var(--font-body-m);
                font-weight: var(--font-semibold);
                line-height: var(--font-line-height-body-m);
                letter-spacing: 0;

                &:not(.cta):hover {
                    text-decoration: underline;
                }
            }

            .cta {
                background: transparent;
                border: 1px solid var(--color-fg-inverse);
                color: var(--color-fg-inverse);
                border-radius: var(--radius-xs);
                padding-block: var(--spacing-50);
                padding-inline: var(--spacing-100);
            }
        }
    }

    .brand {
        display: flex;
        flex-direction: column;
        line-height: 1;
        text-decoration: none;
    }

    .brand-name {
        font-family: var(--font-family-title), serif;
        font-weight: var(--font-semibold);
        font-size: var(--font-title-xs);
        letter-spacing: 0.01em;
    }

    .brand-tagline {
        font-size: 9.5px;
        letter-spacing: 0.28em;
        text-transform: uppercase;
        margin-top: 5px;
    }
</style>
