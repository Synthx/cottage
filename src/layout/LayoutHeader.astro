---
import LayoutHeaderDesktop from '@/layout/LayoutHeaderDesktop.astro';

interface Props {
    variant?: 'default' | 'transparent';
}

const { variant = 'default' } = Astro.props;
---

<header class:list={['header', variant]} data-header>
    <div class="header-top-bar">
        <div class="header-top-bar-content">
            <a href="tel:+33620652511" aria-label="Appeler maintenant"
                >+33 (0)6 20 65 25 11</a
            >
            <a
                href="mailto:laurent@lamaisondutraict.com"
                aria-label="Envoyer un email">laurent@lamaisondutraict.com</a
            >
        </div>
    </div>
    <LayoutHeaderDesktop />
</header>

<style>
    @property --reveal {
        syntax: '<number>';
        inherits: false;
        initial-value: 0;
    }

    @property --background-color {
        syntax: '<color>';
        inherits: false;
        initial-value: var(--color-bg);
    }

    .header {
        position: fixed;
        top: 0;
        width: 100%;
        z-index: 100;

        &.default {
            background: var(--color-bg);
            color: var(--color-fg);
            border-bottom: 1px solid var(--line);
            box-shadow: rgba(58, 42, 30, 1) 0 6px 18px -8px;
        }

        &.transparent {
            color: color-mix(
                in srgb,
                var(--color-fg) calc(var(--reveal) * 100%),
                var(--color-fg-inverse)
            );
            background: var(--background-color);
            animation: headerReveal linear both;
            animation-timeline: scroll(root);
            animation-range: 0 200px;
        }

        .header-top-bar {
            background-color: var(--color-bg-brand);
            color: var(--color-fg-inverse);

            .header-top-bar-content {
                display: flex;
                justify-content: flex-end;
                align-items: center;
                gap: var(--spacing-150);
                max-width: 1280px;
                margin: 0 auto;
                padding-block: var(--spacing-50);
                padding-inline: var(--spacing-450);

                a {
                    font-size: var(--font-body-s);
                    line-height: var(--font-line-height-body-s);
                    text-decoration: none;
                }
            }
        }
    }

    @keyframes headerReveal {
        from {
            --reveal: 0;
            --background-color: linear-gradient(
                to top,
                rgba(0, 0, 0, 0) 0%,
                rgba(0, 0, 0, 0) 2%,
                rgba(0, 0, 0, 0.9) 100%
            );
        }
        to {
            --reveal: 1;
            --background-color: var(--color-bg);
        }
    }
</style>
