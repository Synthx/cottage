---
import SectionHeading from '@/components/pages/SectionHeading.astro';
import type { Link } from '@/content/schemas/shared.ts';
import Breadcrumb from '@/components/pages/Breadcrumb.astro';

interface Props {
    backgroundColor: 'base' | 'alternate' | 'dark';
    breadcrumbs?: Link[];
    class?: string;
    eyebrow?: string;
    title?: string;
}

const {
    backgroundColor,
    breadcrumbs,
    class: className,
    eyebrow,
    title,
} = Astro.props;
---

<section class:list={[`background-color-${backgroundColor}`, className]}>
    <div class="background-section">
        {breadcrumbs && <Breadcrumb links={breadcrumbs} />}
        {title && <SectionHeading eyebrow={eyebrow}>{title}</SectionHeading>}
        <slot />
    </div>
</section>

<style>
    .background-section {
        width: 100%;
        max-width: 1280px;
        margin: 0 auto;
        display: flex;
        flex-direction: column;
        gap: var(--spacing-250);
        padding-block: var(--spacing-250);
        padding-inline: var(--spacing-150);

        @media (min-width: 1024px) {
            padding-inline: var(--spacing-450);
        }
    }
</style>
