---
import type { ImageMetadata } from 'astro';
import Picture from 'astro/components/Picture.astro';

interface Props {
    image: ImageMetadata;
    label: string;
    class?: string;
}

const { image, label, class: className } = Astro.props;
---

<div class:list={['photo-card', className]}>
    <Picture
        layout="constrained"
        formats={['avif', 'webp']}
        height={500}
        width={400}
        src={image}
        alt={label}
    />
    <p class="handwritten">{label}</p>
</div>

<style>
    .photo-card {
        position: relative;
        height: 100%;
        width: 100%;
        background: var(--background);
        border: 10px solid var(--background);
        border-bottom: 50px solid var(--background);
        border-radius: var(--radius-xs);
        box-shadow:
            rgba(0, 0, 0, 0.2) 0 2px 3px,
            rgba(0, 0, 0, 0.1) 0 5px 32px;

        .handwritten {
            position: absolute;
            bottom: -30px;
            left: 0;
            right: 0;
            color: var(--primary);
            text-align: center;
            font-family: sans-serif;
            font-size: var(--font-body-m);
            line-height: 1;
            letter-spacing: 0;
        }
    }
</style>
