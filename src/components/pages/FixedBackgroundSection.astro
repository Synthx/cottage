---
import type { ImageMetadata } from 'astro';
import Picture from 'astro/components/Picture.astro';
import ScrollIndicator from '@/components/ScrollIndicator.astro';

interface Props {
    backgroundColor: string;
    backgroundImage: ImageMetadata;
    title?: string;
    class?: string;
    includeAsPicture?: boolean;
    scrollIndicator?: boolean;
}

const {
    backgroundColor,
    backgroundImage,
    class: className,
    includeAsPicture = true,
    scrollIndicator = true,
    ...rest
} = Astro.props;
---

<section
    class:list={[
        className,
        'background-image-section-container',
        `background-color-ral-${backgroundColor}`,
    ]}
    {...rest}
>
    <div class="background-image-section">
        <slot />
    </div>
    {scrollIndicator && <ScrollIndicator />}
    {
        includeAsPicture && (
            <Picture
                src={backgroundImage}
                formats={['avif', 'webp']}
                layout="full-width"
                loading="eager"
                fetchpriority="high"
                class="background-image-picture"
                alt=""
            />
        )
    }
</section>

<style>
    .background-image-section-container {
        position: relative;

        .scroll-indicator {
            position: absolute;
            bottom: var(--spacing-100);
            left: 50%;
            transform: translateX(-50%);
        }

        .background-image-section {
            height: 100%;
            max-width: 1280px;
            width: 100%;
            margin: 0 auto;
            display: flex;
            flex-direction: column;
            padding: var(--spacing-250) var(--spacing-125);

            @media (min-width: 1024px) {
                padding: var(--spacing-250) var(--spacing-500);
            }
        }

        .background-image-picture {
            position: absolute;
            z-index: -1;
            inset: 0;
            height: 100%;
            width: 100%;
            max-height: 100vh;
            object-fit: cover;
            object-position: top;
            pointer-events: none;
        }
    }
</style>
