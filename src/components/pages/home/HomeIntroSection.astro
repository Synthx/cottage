---
import { getCollection } from 'astro:content';
import BackgroundSection from '@/components/pages/BackgroundSection.astro';

const bedroomLength = (await getCollection('bedrooms')).length;

const STATS = [
    { value: bedroomLength, label: 'chambres' },
    { value: '1834', label: 'la ferme' },
    { value: "30'", label: 'de Lille' },
];
---

<BackgroundSection backgroundColor="alternate">
    <div class="inner">
        <p class="lead">
            Une longère de 1834 patiemment réveillée : tomettes cirées, poutres
            apparentes et grandes fenêtres ouvertes sur le verger.
            <span class="accent"> On y vient pour souffler.</span>
        </p>
        <div class="stats">
            {
                STATS.map((stat) => (
                    <div class="stat">
                        <div class="value">{stat.value}</div>
                        <div class="label">{stat.label}</div>
                    </div>
                ))
            }
        </div>
    </div>
</BackgroundSection>

<style>
    .inner {
        display: flex;
        align-items: center;
        gap: var(--spacing-400);
    }

    .lead {
        flex: 1;
        font-family: var(--font-family-title), serif;
        font-size: var(--font-title-m);
        font-weight: var(--font-medium);
        line-height: 1.42;
        color: var(--brown);
        text-wrap: pretty;
        margin: 0;
    }

    .accent {
        color: var(--terra);
    }

    .stats {
        display: flex;
        gap: var(--spacing-300);
        flex: none;
    }

    .stat {
        text-align: center;
    }

    .value {
        font-family: var(--font-family-title), serif;
        font-size: var(--font-title-l);
        color: var(--terra);
        line-height: 1;
    }

    .stat .label {
        font-size: var(--font-body-xs);
        letter-spacing: 0.12em;
        text-transform: uppercase;
        color: var(--muted);
        margin-top: 6px;
    }

    @media (max-width: 860px) {
        .inner {
            flex-direction: column;
            gap: var(--spacing-250);
            align-items: flex-start;
        }

        .stats {
            gap: var(--spacing-250);
        }
    }
</style>
