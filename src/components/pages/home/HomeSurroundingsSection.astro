---
import PhotoPlaceholder from '@/components/PhotoPlaceholder.astro';
import BackgroundSection from '@/components/pages/BackgroundSection.astro';

const PLACES = [
    {
        title: 'Le Mont Cassel',
        text: 'Village perché, moulin et panorama sur la plaine flamande. 15 min.',
    },
    {
        title: 'L’abbaye du Mont des Cats',
        text: 'Fromage, bière trappiste et sentiers boisés. 20 min.',
    },
    {
        title: 'Marchés & estaminets',
        text: 'Produits fermiers et tables flamandes chaque week-end.',
    },
];
---

<BackgroundSection
    backgroundColor="alternate"
    eyebrow="Les environs"
    title="À explorer alentour"
>
    <div class="grid">
        {
            PLACES.map((place) => (
                <article class="card">
                    <PhotoPlaceholder class="thumb" />
                    <div class="body">
                        <h4>{place.title}</h4>
                        <p>{place.text}</p>
                    </div>
                </article>
            ))
        }
    </div>
</BackgroundSection>

<style>
    .grid {
        display: grid;
        grid-template-columns: repeat(3, 1fr);
        gap: var(--spacing-175);
    }

    .card {
        background: var(--paper);
        border: 1px solid var(--line);
        border-radius: var(--radius-s);
        overflow: hidden;
    }

    .thumb {
        height: 170px;
    }

    .body {
        padding: var(--spacing-150) var(--spacing-150);
    }

    .card h4 {
        font-size: var(--font-title-s);
        color: var(--brown);
    }

    .card p {
        font-size: var(--font-body-s);
        color: var(--muted);
        margin: var(--spacing-50) 0 0;
    }

    @media (max-width: 860px) {
        .grid {
            grid-template-columns: 1fr;
        }
    }
</style>
