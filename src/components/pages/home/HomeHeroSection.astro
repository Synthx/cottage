---
import { Picture } from 'astro:assets';
import HeroImage from '@/assets/images/home/hero.jpg';
---

<section class="hero">
    <Picture
        src={HeroImage}
        formats={['avif', 'webp']}
        class="hero-bg"
        alt=""
        loading="eager"
        fetchpriority="high"
        layout="full-width"
    />
    <div class="hero-container">
        <div class="hero-content">
            <p class="hero-eyebrow">Campagne du Nord</p>
            <h1>
                Une ferme flamande restaurée,<br />
                <span class="accent">où le temps ralentit.</span>
            </h1>
        </div>
    </div>
</section>

<style>
    .hero {
        position: relative;
        height: 100vh;
        background-color: var(--color-bg);
    }

    .hero-bg {
        position: absolute;
        z-index: 0;
        inset: 0;
        height: 100%;
        width: 100%;
        object-fit: cover;
    }

    .hero-container {
        position: absolute;
        inset: 0;
        z-index: 1;
        background: linear-gradient(
            to bottom,
            rgba(0, 0, 0, 0) 0%,
            rgba(0, 0, 0, 0) 2%,
            rgba(0, 0, 0, 0.5) 100%
        );
    }

    .hero-content {
        height: 100%;
        width: 100%;
        display: flex;
        flex-direction: column;
        justify-content: flex-end;
        gap: var(--spacing-100);
        max-width: 1280px;
        margin: 0 auto;
        padding-block: var(--spacing-250);
        padding-inline: var(--spacing-450);
    }

    .hero-eyebrow {
        color: var(--clay);
    }

    .hero-eyebrow span {
        font-size: var(--font-body-xs);
        letter-spacing: 0.26em;
        text-transform: uppercase;
        font-weight: var(--font-semibold);
    }

    .hero h1 {
        color: var(--cream);
        font-size: var(--font-title-2xl);
        line-height: var(--font-line-height-title-2xl);
    }

    .hero h1 .accent {
        font-style: italic;
        color: var(--clay);
    }
</style>
